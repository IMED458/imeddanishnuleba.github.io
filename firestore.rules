rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app/settings {
      allow read, write: if true;
    }

    match /records/{recordId} {
      allow read, write, delete: if true;
    }

    match /templates/{templateId} {
      allow read, write, delete: if true;
    }

    match /users/{userId} {
      allow read, write, delete: if true;
    }
  }
}
